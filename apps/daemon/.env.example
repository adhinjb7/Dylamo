DAEMON_SERVER_URL=wss://replace-with-your-public-host/daemon
DAEMON_MACHINE_ID=replace-with-generated-uuid
DAEMON_TOKEN=replace-with-generated-secret
DAEMON_NAME=Demo laptop
DAEMON_PORT=3210
# Optional local-only synthetic monitor for the second live demo. This serves
# a loopback page and forwards only its fixed, synthetic incident events over
# the already authenticated daemon connection. It never sends SMS itself.
# SITE_MONITOR_DEMO_ENABLED=false
# SITE_MONITOR_DEMO_PORT=4174
# Opt-in read-only Codex task. Use a dedicated, non-sensitive repository.
# CODEX_AGENT_ENABLED=true
# CODEX_WORKSPACE=C:\path\to\safe-demo-repository
# CODEX_COMMAND=C:\path\to\codex.exe
# CODEX_MODEL_DEFAULT=gpt-6-sol
# Optional coding mode: permits edits and local tests in the configured workspace.
# Off by default; use only a disposable, non-sensitive repository. .git remains
# protected, .env files are denied, system temp is read-only, and command
# network access stays off. Test scratch moves to CODEX_WORKSPACE\.dylamo-tmp.
# CODEX_ALLOW_WORKSPACE_WRITE=false
# Windows compatibility: broad reads outside the demo repo. In read-only mode
# this selects the built-in profile; in edit mode it removes the root read deny.
# Enable only with the machine owner's consent.
# CODEX_ALLOW_FULL_READ=false
# Experimental one-action approval: one operator-chosen exact command, one use per run.
# Keep unset until all local approval rehearsals pass. No session-wide grants.
# CODEX_APPROVAL_COMMAND=git push origin HEAD:refs/heads/phone-demo
# With that exact value, either "Run the demo push" or "Push the demo repo"
# prepares the literal command for Codex. It does not approve it or change the remote.
