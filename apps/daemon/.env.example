DAEMON_SERVER_URL=wss://replace-with-your-public-host/daemon
DAEMON_MACHINE_ID=replace-with-generated-uuid
DAEMON_TOKEN=replace-with-generated-secret
DAEMON_NAME=Demo laptop
DAEMON_PORT=3210
# Optional monitor: a loopback page sends fixed signed events through the authenticated daemon; never SMS.
# SITE_MONITOR_DEMO_ENABLED=false
# SITE_MONITOR_DEMO_PORT=4174
# Opt-in read-only Codex task. Use a dedicated, non-sensitive repository.
# CODEX_AGENT_ENABLED=true
# CODEX_WORKSPACE=path-to-safe-demo-repository
# CODEX_COMMAND=path-to-codex
# CODEX_MODEL_DEFAULT=gpt-6-sol
# Optional write mode for a disposable repository. .git and .env stay protected; network stays off.
# CODEX_ALLOW_WORKSPACE_WRITE=false
# Broad reads outside the demo repository; write mode removes the root read deny. Enable only with owner consent.
# CODEX_ALLOW_FULL_READ=false
# One exact operator-chosen command, one use per run. Enable only after local rehearsal.
# CODEX_APPROVAL_COMMAND=git push origin HEAD:refs/heads/phone-demo
# “Run the demo push” or “Push the demo repo” prepares this command; neither approves or runs it.
