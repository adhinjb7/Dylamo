TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_BASE_URL=https://replace-with-your-public-host
PORT=3000
DATABASE_URL=file:./data/agent-phone.db
ALLOWED_CALLER_NUMBER=+15065550123
# Set to your purchased Twilio number only when ready for real outbound approval callback calls.
# TWILIO_PHONE_NUMBER=+15065550124
DEMO_PIN_HASH=replace-with-scrypt-hash
# Keep tone mode until you intentionally enable paid Realtime API usage.
VOICE_MODE=tone
# Use AGENT_MODE=fake with VOICE_MODE=realtime and a paired daemon for the P0.6 simulated task.
# Use AGENT_MODE=codex only after enabling the read-only Codex agent in daemon .env.
AGENT_MODE=voice
# OPENAI_API_KEY=add-privately-for-realtime-mode
# Optional P0.4 daemon pairing. Generate with: node apps/daemon/scripts/generate-pairing.mjs
# DAEMON_CREDENTIALS=machine-uuid:sha256-token-hash
